# PostgreSQL (relaxdev: internal network, no TLS — no sslmode/ssl/channel_binding in the URL).
# Empty = local SQLite file finboard.db (development only).
DATABASE_URL=

# Master key for encrypting marketplace API keys in the database. Long random string.
# Changing it makes stored keys unreadable (re-enter them on the «Кабинеты» page).
APP_SECRET=

# Owner password for the dashboard. Empty = no login (local only).
OWNER_PASSWORD=

# Daily sync hour, Moscow time
SCHEDULER_TIMEZONE=Europe/Moscow
SYNC_HOUR=6
